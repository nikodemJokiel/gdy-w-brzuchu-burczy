---
/**
 * Header component — fixed navigation bar, edge to edge.
 * Minimalist: hamburger flush-left, logo centered, theme toggle flush-right.
 */
import ThemeToggle from "./ThemeToggle.tsx";
import HeaderLeft from "./HeaderLeft.tsx";
---

<header class="header" id="site-header">
  <div class="header__inner">
    <HeaderLeft client:load />

    <a href="/" class="header__logo" aria-label="Strona główna">
      <span class="header__logo-text">Gdy w brzuchu burczy</span>
    </a>

    <div class="header__right">
      <nav class="header__nav" aria-label="Nawigacja główna">
        <a href="/wspolpraca" class="header__nav-link">Współpraca</a>
        <a href="/o-mnie" class="header__nav-link">O mnie</a>
      </nav>
      <div class="header__social">
        <a
          href="https://www.facebook.com/gdywbrzuchuburczy.blog/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-facebook"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a
          href="https://www.instagram.com/gdywbrzuchuburczy/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        </a>
      </div>
      <ThemeToggle client:load />
    </div>
  </div>
</header>

<style lang="scss">
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: $z-header;
    height: $header-height;
    background-color: transparent;
    transition: background-color $transition-normal;

    &__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
      padding: 0 $space-12;
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      @media (max-width: 640px) {
        padding: 0 $space-2;
      }
      /* NO max-width — full edge-to-edge */
    }

    &__logo {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      color: var(--color-heading);
      text-decoration: none;
      white-space: nowrap;

      &-text {
        font-family: $font-heading;
        font-size: $font-size-lg;
        font-weight: $font-weight-medium;
        letter-spacing: -0.01em;
      }
    }

    &__right {
      display: flex;
      align-items: center;
      gap: $space-4;
      
      @media (max-width: 640px) {
        gap: $space-2;
      }
    }

    &__social {
      display: flex;
      align-items: center;
      gap: $space-5;

      a {
        display: flex;
        align-items: center;
        color: var(--color-muted);
        transition: color $transition-fast;

        &:hover {
          color: var(--color-text);
        }
      }

      @media (max-width: $bp-mobile) {
        display: none;
      }
    }

    &__nav {
      display: flex;
      gap: $space-4;

      @media (max-width: $bp-mobile) {
        display: none;
      }

      &-link {
        font-size: $font-size-sm;
        font-weight: $font-weight-normal;
        color: var(--color-muted);
        transition: color $transition-fast;
        text-decoration: none;

        &:hover {
          color: var(--color-text);
        }
      }
    }
  }
</style>

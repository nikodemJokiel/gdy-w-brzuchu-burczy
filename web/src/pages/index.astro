---
import BaseLayout from "../layouts/BaseLayout.astro";
import CookieConsent from "../components/CookieConsent.tsx";
import PostGridClient from "../components/PostGridClient.tsx";
import HomeCarouselClient from "../components/HomeCarouselClient.tsx";
import { sanityClient, RECIPES_QUERY, CAROUSEL_QUERY } from "../lib/sanity";

const title = "Gdy w brzuchu burczy";
const description = "Blog kulinarny ze sprawdzonymi, pysznymi przepisami.";

const [posts, carouselPosts] = await Promise.all([
  sanityClient.fetch(RECIPES_QUERY),
  sanityClient.fetch(CAROUSEL_QUERY)
]);
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <HomeCarouselClient client:load posts={carouselPosts} />
    
    <!-- Lista postów -->
    <PostGridClient client:load initialPosts={posts} />
  </div>
  <CookieConsent client:idle />
</BaseLayout>

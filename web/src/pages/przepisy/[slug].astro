---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanityClient, RECIPE_BY_SLUG_QUERY, urlFor } from "../../lib/sanity";
import RecipeHeroClient from "../../components/RecipeHeroClient.tsx";
import IngredientList from "../../components/IngredientList.tsx";
import PortableTextRenderer from "../../components/PortableTextRenderer.tsx";
import NutritionFacts from "../../components/NutritionFacts.astro";
import InstructionList from "../../components/InstructionList.tsx";
import SanityComments from "../../components/SanityComments.tsx";

import homeIcon from "/src/assets/icons/home.svg?raw";
import articleIcon from "/src/assets/icons/article.svg?raw";
import checklistIcon from "/src/assets/icons/checklist.svg?raw";
import chefHatIcon from "/src/assets/icons/chef_hat.svg?raw";
import commentIcon from "/src/assets/icons/comment.svg?raw";

export async function getStaticPaths() {
  const query = `*[_type == "recipe"] { "slug": slug.current }`;
  const recipes = await sanityClient.fetch(query);
  return recipes.map((recipe: any) => ({
    params: { slug: recipe.slug },
  }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(RECIPE_BY_SLUG_QUERY, { slug });

if (!post) {
  return Astro.redirect("/404");
}

const title = `${post.title} - Gdy w brzuchu burczy`;
const description = post.excerpt || `Przepis na ${post.title}`;

// Hero uses mainImage, so we can use the entire gallery in the content
const contentGallery = post.gallery || [];
---

<BaseLayout title={title} description={description}>
  <main class="container" style="padding-bottom: 4rem;" data-pagefind-body>
    
    <div id="recipe-hero">
      <RecipeHeroClient 
        client:load
        title={post.title}
        publishedAt={post.publishedAt}
        prepTime={post.prepTime}
        cookTime={post.cookTime}
        tags={post.tags}
        mainImage={post.mainImage}
        gallery={post.gallery}
      />
    </div>
    
    <div class="recipe-layout">
      
      {/* 2. Ingredients */}
      <aside id="recipe-ingredients" class="recipe-layout__sidebar">
        <div class="wake-lock-bar">
          <label class="wake-lock-switch">
            <input type="checkbox" class="wake-lock-checkbox" />
            <span class="wake-lock-slider"></span>
            <span class="wake-lock-text">Nie wygaszaj ekranu</span>
          </label>
        </div>
        {post.ingredients && post.ingredients.length > 0 && (
          <IngredientList client:load ingredients={post.ingredients} />
        )}
      </aside>

      {/* 1. Description */}
      <div id="recipe-description" class="recipe-layout__body">
        <PortableTextRenderer value={post.body} />
      </div>
      
      {/* 3. Instructions */}
      <div id="recipe-instructions" class="recipe-layout__instructions-section">
        <div class="wake-lock-bar">
          <label class="wake-lock-switch">
            <input type="checkbox" class="wake-lock-checkbox" />
            <span class="wake-lock-slider"></span>
            <span class="wake-lock-text">Nie wygaszaj ekranu</span>
          </label>
        </div>
        <div class="recipe-layout__instructions-header">
          <h2>Sposób przygotowania</h2>
          {post.servings && (
            <span class="recipe-layout__servings">Liczba porcji: <strong>{post.servings}</strong></span>
          )}
        </div>
        <InstructionList client:load instructions={post.instructions} />
      </div>
      
      {/* Nutrition Info */}
      {post.nutritionInfo && (
        <div class="recipe-layout__nutrition">
          <NutritionFacts {...post.nutritionInfo} />
        </div>
      )}
      
      {/* 4. Comments */}
      <div id="recipe-comments" class="recipe-layout__comments">
        <SanityComments client:visible comments={post.comments} recipeId={post._id} />
      </div>
      
    </div>

    {/* Bottom Mobile Navigation */}
    <nav class="mobile-nav">
      <button class="mobile-nav__btn active" data-target="recipe-hero" aria-label="Góra">
        <Fragment set:html={homeIcon} />
      </button>
      <button class="mobile-nav__btn" data-target="recipe-description" aria-label="Opis">
        <Fragment set:html={articleIcon} />
      </button>
      <button class="mobile-nav__btn" data-target="recipe-ingredients" aria-label="Składniki">
        <Fragment set:html={checklistIcon} />
      </button>
      <button class="mobile-nav__btn" data-target="recipe-instructions" aria-label="Przygotowanie">
        <Fragment set:html={chefHatIcon} />
      </button>
      <button class="mobile-nav__btn" data-target="recipe-comments" aria-label="Komentarze">
        <Fragment set:html={commentIcon} />
      </button>
    </nav>
  </main>
</BaseLayout>

<script>
  // Dynamic active navigation tracking
  const observerOptions = {
    root: null,
    rootMargin: '-30% 0px -40% 0px', // Focused band in the middle
    threshold: 0
  };

  const buttons = document.querySelectorAll('.mobile-nav__btn');
  const targets = Array.from(buttons).map(btn => btn.getAttribute('data-target')).filter(Boolean);

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        buttons.forEach(btn => {
          if (btn.getAttribute('data-target') === id) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
      }
    });
  }, observerOptions);

  targets.forEach(id => {
    if (!id) return;
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // Smooth scroll with offset for mobile header
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;
      const el = document.getElementById(targetId);
      if (el) {
        const yOffset = -70; // Offset for header
        const y = el.getBoundingClientRect().top + window.pageYOffset + yOffset;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    });
  });

  // Screen Wake Lock API Implementation
  let wakeLock = null;

  async function requestWakeLock() {
    try {
      if ('wakeLock' in navigator) {
        // @ts-ignore
        wakeLock = await navigator.wakeLock.request('screen');
        console.log('Wake Lock active!');
      }
    } catch (err) {
      console.error('Failed to lock screen wake:', err);
    }
  }

  function releaseWakeLock() {
    if (wakeLock) {
      // @ts-ignore
      wakeLock.release().then(() => {
        wakeLock = null;
        console.log('Wake Lock released!');
      });
    }
  }

  const checkboxes = document.querySelectorAll('.wake-lock-checkbox');

  checkboxes.forEach(cb => {
    cb.addEventListener('change', async () => {
      // @ts-ignore
      const checked = cb.checked;
      
      // Sync all checkboxes on the page
      checkboxes.forEach(otherCb => {
        // @ts-ignore
        otherCb.checked = checked;
      });

      if (checked) {
        await requestWakeLock();
      } else {
        releaseWakeLock();
      }
    });
  });

  // Re-request wake lock if tab is minimized and returned
  document.addEventListener('visibilitychange', async () => {
    if (wakeLock !== null && document.visibilityState === 'visible') {
      await requestWakeLock();
    }
  });
</script>

<style lang="scss">
  .recipe-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 1rem;
    
    @media (min-width: 1024px) {
      display: flow-root; // switch from grid to normal block layout with floats to prevent stretching rows
    }

    &__sidebar {
      @media (max-width: 1023px) {
        grid-row: 2; // Ingredients second on mobile
      }
      @media (min-width: 1024px) {
        float: left;
        width: 300px;
        position: sticky;
        top: 100px;
        margin-bottom: 2rem;
      }
    }
    
    &__body {
      margin-bottom: 1rem;
      @media (max-width: 1023px) {
        grid-row: 1; // Description first on mobile
        padding: 0 0.5rem;
      }
      @media (min-width: 1024px) {
        margin-left: 340px; // width of sidebar + gap
      }
    }
    
    &__inline-image {
      width: auto;
      max-width: 100%;
      max-height: 600px;
      object-fit: contain;
      border-radius: 0;
      margin: 2rem 0;
    }
    
    &__instructions-section {
      font-size: 1.05rem;
      margin: 1rem 0;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
      
      @media (max-width: 1023px) {
        grid-row: 3; // Instructions third on mobile
      }
      @media (min-width: 1024px) {
        margin-left: 340px; // width of sidebar + gap
      }
    }
    
    &__instructions-header {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
      
      h2 {
        margin: 0;
        font-family: $font-heading !important;
        font-size: 1.5rem;
        color: var(--color-text);
      }
    }
    
    &__servings {
      font-size: 0.9rem;
      color: var(--color-muted);
      background-color: var(--color-surface);
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      border: 1px solid var(--color-border);
    }

    &__nutrition {
      @media (max-width: 1023px) {
        grid-row: 4; // Nutrition fourth on mobile
      }
      @media (min-width: 1024px) {
        margin-left: 340px; // width of sidebar + gap
      }
    }
    
    &__comments {
      @media (max-width: 1023px) {
        grid-row: 5; // Comments fifth on mobile
      }
      @media (min-width: 1024px) {
        margin-left: 340px; // width of sidebar + gap
      }
    }
  }

  .mobile-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-around;
    padding: 0.5rem 1rem 1.25rem 1rem; // Increased vertical padding and safe area at bottom
    z-index: 9999; // Ensure it stays on top of everything
    box-sizing: border-box;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.05);

    @media (min-width: 1024px) { // Changed from 768px to 1024px to match collapse breakpoint
      display: none;
    }

    &__btn {
      background: none;
      border: none;
      padding: 0.5rem;
      color: var(--color-muted);
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      outline: none;

      :global(svg) {
        width: 26px;
        height: 26px;
        fill: currentColor; // Ensure fill works
        transition: transform 0.2s ease;
      }

      &.active {
        color: var(--color-heading);
        opacity: 1;
        transform: scale(1.15);
      }
    }
  }

  @media (max-width: 1023px) {
    main.container {
      padding-bottom: 6rem !important;
    }
    
    // Hide scroll-to-top on mobile recipe page
    :global(.scroll-to-top) {
      display: none !important;
    }
  }

  // Wake Lock Switch Styles
  .wake-lock-bar {
    display: none;
    
    @media (max-width: 1023px) {
      display: flex;
      justify-content: flex-start; // aligned to left
      margin-bottom: 0.75rem;
    }
  }

  .wake-lock-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--color-muted);
    user-select: none;
    font-family: $font-body;

    input {
      display: none;
    }
  }

  .wake-lock-slider {
    position: relative;
    width: 32px;
    height: 18px;
    background-color: var(--color-border);
    border-radius: 9px;
    transition: background-color 0.2s ease;

    &::after {
      content: "";
      position: absolute;
      top: 2px;
      left: 2px;
      width: 14px;
      height: 14px;
      background-color: var(--color-bg);
      border-radius: 50%;
      transition: transform 0.2s ease;
    }
  }

  .wake-lock-checkbox:checked + .wake-lock-slider {
    background-color: var(--color-text);

    &::after {
      transform: translateX(14px);
    }
  }
</style>
